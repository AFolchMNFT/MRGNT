{
  "hosting": [
    {
      "target": "prod",
      "public": "public",
      "ignore": ["firebase.json", "**/.*", "node_modules/**"],
      "rewrites": [
        {
          "source": "/api/**",
          "function": "api",
          "region": "us-central1"
        },
        {
          "source": "/evento.html",
          "function": "api",
          "region": "us-central1"
        },
        {
          "source": "/noticia.html",
          "function": "api",
          "region": "us-central1"
        },
        {
          "source": "/artista.html",
          "function": "api",
          "region": "us-central1"
        }
      ]
    },
    {
      "target": "dev",
      "public": "public",
      "ignore": ["firebase.json", "**/.*", "node_modules/**"],
      "rewrites": [
        {
          "source": "/api/**",
          "function": "apiDev",
          "region": "us-central1"
        },
        {
          "source": "/evento.html",
          "function": "apiDev",
          "region": "us-central1"
        },
        {
          "source": "/noticia.html",
          "function": "apiDev",
          "region": "us-central1"
        },
        {
          "source": "/artista.html",
          "function": "apiDev",
          "region": "us-central1"
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5050 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true },
    "singleProjectMode": true
  }
}
