{
  "name": "mrgnt",
  "private": true,
  "version": "2.0.0",
  "description": "MRGNT site + admin panel (Firebase)",
  "scripts": {
    "dev": "firebase emulators:start --import=./emulator-data --export-on-exit",
    "deploy": "firebase deploy --only hosting,functions,firestore:rules,storage:rules",
    "create-admin": "cd functions && node scripts/create-admin.js",
    "migrate": "cd functions && node scripts/migrate-seed-data.js",
    "migrate-notes": "cd functions && node scripts/migrate-article-notes-to-html.js",
    "backfill-event-slugs": "cd functions && node scripts/backfill-event-slugs.js"
  }
}
